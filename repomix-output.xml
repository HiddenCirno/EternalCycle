        /// <returns>返回价格</returns>
        public static int GetPresetPrice(List<Item> item, LoadModContext context)
        {
            int price = 0;
            if (item.Count > 0)
            {
                foreach (Item items in item)
                {
                    price += GetItemCommonPrice(items.Template, context);
                }
                return price;
            }
            return 1;
        }

