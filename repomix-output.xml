                        InitCultistCircleRecipeData(recipeData, context);
                    }
                    catch (Exception ex)
                    {
                        EventManager.EventLogger.Error($"注册 邪教圈 配方时发生错误：指定的文件 {correctpath} 存在问题", ex);
                    }
                };
