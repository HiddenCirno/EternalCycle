                var tpl = rootItem.Template;

                // 如果字典里还没这个 Tpl，建个档案
                if (!newPresetCache.ContainsKey(tpl))
                {
                    newPresetCache[tpl] = new PresetCacheDetails
                    {
                        PresetIds = new HashSet<MongoId>()
