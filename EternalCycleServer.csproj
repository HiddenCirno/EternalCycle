<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>VulcanCore</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
	  <NoWarn>CS8622</NoWarn>
    <Version>0.0.1</Version>
    <!-- SPT 5.0 部署路径（4.1 时期为 I:\TKF\SPT_Runtime，该目录只读，禁止写入） -->
    <OutputPath>I:\build\SPT_Runtime\user\mods\EternalCycleServer\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <!--
      SPT 5.0 运行时目录。

      ⚠ 这里用 Reference + HintPath 而非 PackageReference 的原因：
        nuget.org 上的 SPTarkov.* 包目前最高只发布到 4.1.2，5.0.0 尚未上线
        （已核对 https://api.nuget.org/v3-flatcontainer/sptarkov.server.core/index.json）。
        直接引用 5.0 运行时程序集可以立刻开工。
        待上游发布 5.0.0 的 NuGet 包后，建议把这四项换回 PackageReference，
        以恢复跨机器构建的可移植性（届时 HintPath 里的绝对路径即可移除）。
    -->
    <SptRuntimeDir>I:\build\SPT_Runtime</SptRuntimeDir>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="config.jsonc">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="items\**\*">
		<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	</Content>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="SPTarkov.Common">
      <HintPath>$(SptRuntimeDir)\SPTarkov.Common.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="SPTarkov.DI">
      <HintPath>$(SptRuntimeDir)\SPTarkov.DI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="SPTarkov.Reflection">
      <HintPath>$(SptRuntimeDir)\SPTarkov.Reflection.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="SPTarkov.Server.Core">
      <HintPath>$(SptRuntimeDir)\SPTarkov.Server.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- 以下两项不是可选的：
         SPTarkov.Server.Core.dll 的公开签名直接暴露了它们定义的类型 ——
           · IModMetadata 用到 SemanticVersioning.Version / Range
             （缺引用报 CS0012: 类型"Version"在未引用的程序集中定义）
           · ProfileHelperPatch 用到 MonoMod.Cil（该类位于 MonoMod.Utils.dll，
             并非独立的 MonoMod.Cil.dll；缺引用报 CS0234）。 -->
    <Reference Include="SemanticVersioning">
      <HintPath>$(SptRuntimeDir)\SemanticVersioning.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="MonoMod.Utils">
      <HintPath>$(SptRuntimeDir)\MonoMod.Utils.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(SptRuntimeDir)\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
</Project>
